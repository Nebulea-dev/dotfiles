# ----------------- Proxy -------------------

export http_proxy=http://webproxy.ext.ti.com:80
export https_proxy=http://webproxy.ext.ti.com:80
export no_proxy=ti.com,localhost,192.168.1.0/24

# ----------------- Starship ----------------

export STARSHIP_CONFIG=~/.starship.toml
eval "$(starship init zsh)"

# ----------------- Antigen -----------------

export ANTIGEN_LOG="/home/lea/antigen.log"
source ~/antigen.zsh

antigen bundle zsh-users/zsh-syntax-highlighting
antigen bundle zsh-users/zsh-autosuggestions

antigen apply

# ----------------- Path --------------------

export PATH=~/bin/:$PATH
export PATH=~/bin/.venv/bin/:$PATH

# ----------------- Aliases -----------------

alias ls='eza -lha'

# ----------------- UV ----------------------



# ----------------- Thefuck -----------------

eval $(thefuck --alias --enable-experimental-instant-mode)

# ----------------- Compiler ----------------

export CXX=/home/lea/gcc-arm-none-eabi-10.3-2021.10/bin/arm-none-eabi-g++
export CC=/home/lea/gcc-arm-none-eabi-10.3-2021.10/bin/arm-none-eabi-gcc

# ----------------- PGP ---------------------

export GPG_TTY=$(tty)
